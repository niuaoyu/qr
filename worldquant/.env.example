# WorldQuant Brain 配置模板
# 复制此文件为 .env 并填写实际值

# ============ 当前机器使用的账号 ============
# 可选: lab, mylab, ubuntu, backup
USER_CHOICE=lab

# ============ WorldQuant 账号配置 ============
LAB_USERNAME=your_email@example.com
LAB_PASSWORD=your_password

MYLAB_USERNAME=your_email@example.com
MYLAB_PASSWORD=your_password

UBUNTU_USERNAME=your_email@example.com
UBUNTU_PASSWORD=your_password

BACKUP_USERNAME=your_email@example.com
BACKUP_PASSWORD=your_password

# ============ 数据库配置 ============
# 数据库类型: sqlite 或 mysql
DB_TYPE=mysql

# MySQL 配置（DB_TYPE=mysql 时生效）
DB_HOST=100.84.80.8
DB_PORT=3306
DB_USER=wq_user
DB_PASSWORD=your_db_password
DB_NAME=worldquant
